
{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "title": "Are Australia's Community Gardens Open to the Public?",
  "width": 650,
  "height": 550,
  "projection": {"type": "mercator"},
  "layer": [
    {
      "data": {
        "url": "../data/states.geojson",
        "format": {"type": "json", "property": "features"}
      },
      "mark": {
        "type": "geoshape",
        "fill": "#f0eee8",
        "stroke": "#99948b",
        "strokeWidth": 1
      }
    },
    {
      "data": {
        "url": "../data/ds1.csv",
        "format": {"type": "csv"}
      },
      "transform": [
        {"calculate": "toNumber(datum.lat)", "as": "latitude_num"},
        {"calculate": "toNumber(datum.long)", "as": "longitude_num"},
        {
          "filter": "isValid(datum.latitude_num) && isValid(datum.longitude_num)"
        }
      ],
      "mark": {
        "type": "circle",
        "size": 65,
        "opacity": 0.8,
        "stroke": "#ffffff",
        "strokeWidth": 0.5
      },
      "encoding": {
        "longitude": {"field": "longitude_num", "type": "quantitative"},
        "latitude": {"field": "latitude_num", "type": "quantitative"},

      "color": {
        "field": "public_access",
        "type": "nominal",
        "title": "Public access",
        "scale": {
          "scheme": "category10"
        },
        "legend": {
          "orient": "bottom",
          "direction": "vertical",
          "labelLimit": 500,
          "titleLimit": 500,
          "columns": 1,
          "labelFontSize": 11
        }
      },

        "tooltip": [
          {"field": "garden", "type": "nominal", "title": "Garden"},
          {"field": "suburb", "type": "nominal", "title": "Suburb"},
          {"field": "state", "type": "nominal", "title": "State"},
          {
            "field": "public_access",
            "type": "nominal",
            "title": "Public access"
          }
        ]
      }
    }
  ]
}
