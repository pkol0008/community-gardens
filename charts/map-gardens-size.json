{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "title": "Where Are Community Gardens Recorded?",
  "width": 650,
  "height": 550,
  "projection": {
    "type": "mercator"
  },
  "layer": [
    {
      "data": {
        "url": "data/states.geojson",
        "format": {
          "type": "json",
          "property": "features"
        }
      },
      "transform": [
        {
          "calculate": "datum.properties.STATE_NAME",
          "as": "state_name"
        },
        {
          "lookup": "state_name",
          "from": {
            "data": {
              "url": "data/ds1-counts.csv",
              "format": {
                "type": "csv"
              }
            },
            "key": "State",
            "fields": [
              "Count"
            ]
          }
        },
        {
          "calculate": "toNumber(datum.Count)",
          "as": "garden_count"
        }
      ],
      "mark": {
        "type": "geoshape",
        "stroke": "#8f8981",
        "strokeWidth": 1
      },
      "encoding": {
        "color": {
          "field": "garden_count",
          "type": "quantitative",
          "title": "Number of garden records",
          "scale": {
            "domainMin": 0,
            "range": [
              "#f7eef1",
              "#dfbcc7",
              "#b75472",
              "#8e3f58"
            ]
          }
        },
        "tooltip": [
          {
            "field": "state_name",
            "type": "nominal",
            "title": "State"
          },
          {
            "field": "garden_count",
            "type": "quantitative",
            "title": "Garden records"
          }
        ]
      }
    },
    {
      "data": {
        "url": "data/ds1.csv",
        "format": {
          "type": "csv",
          "parse": {
            "lat": "number",
            "long": "number"
          }
        }
      },
      "transform": [
        {
          "filter": "isValid(datum.lat) && isValid(datum.long)"
        },
        {
          "calculate": "datum.state == 'VIC' || datum.state == 'Victoria' ? 'Victoria' : datum.state == 'NSW' || datum.state == 'New South Wales' ? 'New South Wales' : datum.state == 'QLD' || datum.state == 'Queensland' ? 'Queensland' : datum.state == 'SA' || datum.state == 'South Australia' ? 'South Australia' : datum.state == 'WA' || datum.state == 'Western Australia' ? 'Western Australia' : datum.state == 'TAS' || datum.state == 'Tasmania' ? 'Tasmania' : datum.state == 'NT' || datum.state == 'Northern Territory' ? 'Northern Territory' : datum.state == 'ACT' || datum.state == 'Australian Capital Territory' ? 'Australian Capital Territory' : trim(datum.state)",
          "as": "state_name"
        },
        {
          "calculate": "toNumber(replace(trim(datum.garden_size_sq_metres_), /\\s/g, ''))",
          "as": "garden_size"
        }
      ],
      "mark": {
        "type": "circle",
        "color": "#5f7ea8",
        "opacity": 0.7,
        "stroke": "#fcfbf8",
        "strokeWidth": 0.8
      },
      "encoding": {
        "longitude": {
          "field": "long",
          "type": "quantitative"
        },
        "latitude": {
          "field": "lat",
          "type": "quantitative"
        },
        "size": {
          "condition": {
            "test": "isValid(datum.garden_size) && datum.garden_size > 0",
            "field": "garden_size",
            "type": "quantitative",
            "scale": {
              "type": "sqrt",
              "range": [
                28,
                450
              ]
            },
            "legend": {
              "title": "Garden area (m\u00b2)"
            }
          },
          "value": 42
        },
        "tooltip": [
          {
            "field": "garden",
            "type": "nominal",
            "title": "Garden"
          },
          {
            "field": "suburb",
            "type": "nominal",
            "title": "Suburb"
          },
          {
            "field": "state_name",
            "type": "nominal",
            "title": "State"
          },
          {
            "field": "year_established",
            "type": "nominal",
            "title": "Year established"
          },
          {
            "field": "garden_size",
            "type": "quantitative",
            "title": "Garden area (m\u00b2)",
            "format": ",.0f"
          }
        ]
      }
    }
  ]
}