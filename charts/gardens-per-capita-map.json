{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "title": "Where Are Garden Records Most Concentrated Relative to Population?",
  "description": "Garden-directory counts are normalised using 2021 Census population.",
  "width": 650,
  "height": 550,
  "projection": {
    "type": "mercator"
  },
  "data": {
    "url": "data/states.geojson",
    "format": {
      "type": "json",
      "property": "features"
    }
  },
  "transform": [
    {
      "calculate": "datum.properties.STATE_NAME",
      "as": "state_name"
    },
    {
      "lookup": "state_name",
      "from": {
        "data": {
          "url": "data/ds1-counts.csv",
          "format": {
            "type": "csv"
          }
        },
        "key": "State",
        "fields": [
          "Count"
        ]
      }
    },
    {
      "lookup": "state_name",
      "from": {
        "data": {
          "url": "data/population.csv",
          "format": {
            "type": "csv"
          }
        },
        "key": "State",
        "fields": [
          "Population"
        ]
      }
    },
    {
      "calculate": "toNumber(datum.Count)",
      "as": "garden_count"
    },
    {
      "calculate": "toNumber(datum.Population)",
      "as": "population"
    },
    {
      "calculate": "datum.garden_count / datum.population * 100000",
      "as": "gardens_per_100k"
    }
  ],
  "mark": {
    "type": "geoshape",
    "stroke": "#fcfbf8",
    "strokeWidth": 1.4
  },
  "encoding": {
    "color": {
      "field": "gardens_per_100k",
      "type": "quantitative",
      "title": "Records per 100,000 people",
      "scale": {
        "range": [
          "#f7eef1",
          "#dfbcc7",
          "#b75472",
          "#8e3f58"
        ]
      }
    },
    "tooltip": [
      {
        "field": "state_name",
        "type": "nominal",
        "title": "State or territory"
      },
      {
        "field": "garden_count",
        "type": "quantitative",
        "title": "Garden records",
        "format": ",.0f"
      },
      {
        "field": "population",
        "type": "quantitative",
        "title": "2021 Census population",
        "format": ","
      },
      {
        "field": "gardens_per_100k",
        "type": "quantitative",
        "title": "Records per 100,000",
        "format": ".2f"
      }
    ]
  }
}